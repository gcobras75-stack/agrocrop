{
  "expo": {
    "name": "AgroCrop",
    "slug": "agrocrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agrocrop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecapro.agrocrop",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "AgroCrop necesita la cámara para fotografiar los títulos parcelarios.",
        "NSPhotoLibraryUsageDescription": "AgroCrop necesita acceso a tus fotos para leer los títulos parcelarios.",
        "NSLocationWhenInUseUsageDescription": "AgroCrop necesita tu ubicación para centrar el mapa en tu parcela.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AgroCrop necesita tu ubicación para centrar el mapa en tu parcela."
      }
    },
    "android": {
      "package": "com.ecapro.agrocrop",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBwEV9hv9psPOCEUMF8ss759PenDtkeUG0"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 600,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroCrop necesita acceso a tus fotos para leer los títulos parcelarios.",
          "cameraPermission": "AgroCrop necesita la cámara para fotografiar los títulos parcelarios."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AgroCrop necesita tu ubicación para centrar el mapa en tu parcela."
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fde12fb9-bb20-409c-b06c-13d5b4474463"
      }
    },
    "owner": "duendexx"
  }
}
